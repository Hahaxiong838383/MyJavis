{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyJavis",
  "version": "0.1.0",
  "identifier": "com.myjavis.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @myjavis/web dev -- --host 127.0.0.1",
    "beforeBuildCommand": "pnpm --filter @myjavis/web build",
    "devUrl": "https://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MyJavis",
        "width": 1120,
        "height": 820,
        "minWidth": 860,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "shortDescription": "MyJavis realtime voice assistant",
    "longDescription": "MyJavis macOS Tauri shell reusing the React Web core.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist"
    }
  }
}
