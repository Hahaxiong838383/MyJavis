# ===== 火山引擎 RTC（AIGC-RTC 全双工 / 移动端路径）=====
VOLC_RTC_APP_ID=
VOLC_RTC_APP_KEY=

# ===== 火山 OpenAPI AK/SK（StartVoiceChat / StopVoiceChat 签名，RTC 路径必需）=====
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=

# ===== CustomLLM 回调（火山云回调我方大脑，必须公网 HTTPS）=====
# 本地验证可用 ngrok/frp 隧道地址；线上填部署域名 https://xxx/v1/chat/completions
CUSTOM_LLM_URL=
# 火山回调时的鉴权 key（须与 RTC LLMConfig.APIKey 一致；留空则 /v1 不校验，仅本地方便）
CUSTOM_LLM_API_KEY=
# RTC 进房开场白（可选）
RTC_WELCOME_MESSAGE=

# ===== 火山 ASR v3（WebSocket bigmodel，WS 路径用）=====
VOLC_ASR_APP_ID=
VOLC_ASR_ACCESS_TOKEN=
VOLC_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
VOLC_ASR_RESOURCE_ID=volc.bigasr.sauc.duration

# ===== 火山 TTS（Doubao 双向流）=====
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=
VOLC_TTS_ENDPOINT=wss://openspeech.bytedance.com/api/v3/tts/bidirection
VOLC_TTS_VOICE=zh_female_tianmeixiaoyuan_moon_bigtts

# ===== LLM（可插拔，OpenAI 兼容端点；RTC CustomLLM 路径必须 OpenAI 兼容）=====
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ===== 服务 =====
PORT=3001
# JWT 鉴权密钥（如启用登录）
AUTH_JWT_SECRET=

# ===== 记忆系统（待产品定义；占位）=====
# MEMORY_BACKEND=sqlite
# MEMORY_DB_PATH=./data/memory.db

# ===== 音乐播放（对接外部 music-orchestrator，可选；留空则优雅降级）=====
MUSIC_ORCHESTRATOR_URL=
MUSIC_ORCHESTRATOR_KEY=
MUSIC_STREAM_PUBLIC_BASE=
